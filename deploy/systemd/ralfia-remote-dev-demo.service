[Unit]
Description=RalfIA isolated remote developer public demo
After=network-online.target ralfia-mcp.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/rlopez/releases/ralfia-remote-dev-demo/current
EnvironmentFile=/home/rlopez/projects/raphiia-openai/.env
Environment=PYTHONPATH=/home/rlopez/releases/ralfia-remote-dev-demo/current
Environment=REMOTE_DEV_DEMO_MODE=mcp
Environment=REMOTE_DEV_MCP_URL=http://127.0.0.1:8102/mcp
Environment=REMOTE_DEV_EXECUTE_CODEX=1
Environment=REMOTE_DEV_CODEX_BIN=/home/rlopez/.local/node_modules/.bin/codex
Environment=REMOTE_DEV_MODEL=gpt-5.6-sol
Environment=REMOTE_DEV_WORKSPACE_ROOT=/home/rlopez/worktrees/ralfia-public-demo
Environment=REMOTE_DEV_WHISPER_URL=http://127.0.0.1:9001
ExecStart=/home/rlopez/projects/ralphiia-quoteops/.venv/bin/python -m uvicorn quoteops.remote_dev_server:app --host 127.0.0.1 --port 8766 --workers 1 --no-access-log
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
MemoryMax=2G
TasksMax=256

[Install]
WantedBy=default.target
